# Credentials for the LOCAL dev tools (tools/*.py). The deployed machine does not read
# this file. Its keys are fly secrets on artel-worlds, handed to each world by
# bundle/run.sh.
#
# Source of truth is AWS Secrets Manager, secret `artel-worlds/env`:
#   uv run python scripts/sync_env_secrets.py --pull    # fetch
#   uv run python scripts/sync_env_secrets.py           # push local changes back
OPENROUTER_API_KEY=sk-or-...
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...
GEMINI_API_KEY=AIza...
