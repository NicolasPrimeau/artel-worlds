# Credentials for the LOCAL dev tools (tools/*.py). Deployed apps do not read this
# file — their keys are fly secrets under each app's own prefix (PHALANX_LLM_KEY,
# ALIBI_LLM_KEY for the verglas app, and so on).
#
# Source of truth is AWS Secrets Manager, secret `artel-worlds/env`:
#   uv run python scripts/sync_env_secrets.py --pull    # fetch
#   uv run python scripts/sync_env_secrets.py           # push local changes back
OPENROUTER_API_KEY=sk-or-...
GROQ_API_KEY=gsk_...
CEREBRAS_API_KEY=csk-...
GEMINI_API_KEY=AIza...
